# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - E-COMMERCE DOCKER SERVICES (PLANTILLA)
# ==============================================================================
# Nombre de proyecto para Docker Compose (aísla red y contenedores)
COMPOSE_PROJECT_NAME=ecommerce

# ------------------------------------------------------------------------------
# SERVICIO WEB (Frontend + Vite Server)
# ------------------------------------------------------------------------------
WEB_PORT=5173

# Dominios y hosts permitidos para Vite (evita el error 'host is not allowed')
# Usa 'true' para permitir cualquier host/dominio, o una lista separada por comas:
# Ejemplo: ALLOWED_HOSTS=blessed-sandals.mixgyt.com,.mixgyt.com,localhost,127.0.0.1
ALLOWED_HOSTS=blessed-sandals.mixgyt.com,.mixgyt.com,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# POSTGRESQL (Base de Datos)
# ------------------------------------------------------------------------------
# Puerto externo del host (5434 evita conflicto con el puerto por defecto 5432)
POSTGRES_PORT=5434
POSTGRES_DB=ecommerce_db
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=ecommerce_password
POSTGRES_HOST=localhost

# Cadena de conexión para desarrollo local en host:
DATABASE_URL=postgresql://ecommerce_user:ecommerce_password@localhost:5434/ecommerce_db

# ------------------------------------------------------------------------------
# MINIO / S3 STORAGE (Almacenamiento de Imágenes, Recursos y Modelos 3D)
# ------------------------------------------------------------------------------
# Puertos externos del host (9002 y 9003 evitan conflicto con 9000 y 9001)
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003

# Credenciales de acceso para MinIO / S3 Client
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=ecommerce-assets

# Endpoints para cliente y consola web
# S3_PUBLIC_URL=/ecommerce-assets sirve recursos vía proxy transparente bajo el mismo dominio/puerto web.
# Esto funciona de forma idéntica en local y en servidores remotos (evita enlaces localhost rotos y bloqueo de puertos).
S3_ENDPOINT=http://localhost:9002
S3_PUBLIC_URL=/ecommerce-assets
S3_CONSOLE_URL=http://localhost:9003
S3_REGION=us-east-1
S3_USE_SSL=false
