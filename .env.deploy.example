# ==============================================================================
# CONFIGURACIÓN DE ENTORNO PARA PRODUCCIÓN / SERVIDOR DEPLOY (VITE + DOCKER)
# ==============================================================================
# Copia este archivo como '.env' en tu servidor de despliegue antes de ejecutar:
#   docker compose up -d --build
# ==============================================================================

# Nombre de proyecto para Docker Compose (aísla red y contenedores)
COMPOSE_PROJECT_NAME=ecommerce

# ------------------------------------------------------------------------------
# SERVICIO WEB (Frontend + Vite Server)
# ------------------------------------------------------------------------------
# Puerto externo del host donde responderá la aplicación (ej. 5173, 80 o 3000)
WEB_PORT=5173

# Dominios y hosts permitidos para Vite (evita el error 'Host is not allowed')
# Agrega tu dominio personalizado, subdominios o usa 'true' para permitir cualquier host:
# Ejemplo: ALLOWED_HOSTS=blessed-sandals.mixgyt.com,.mixgyt.com,localhost,127.0.0.1
ALLOWED_HOSTS=blessed-sandals.mixgyt.com,.mixgyt.com,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# POSTGRESQL (Base de Datos)
# ------------------------------------------------------------------------------
# Puerto externo del host (5434 evita conflicto si el servidor ya tiene un PostgreSQL en 5432)
POSTGRES_PORT=5434
POSTGRES_DB=ecommerce_db
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=ecommerce_password
POSTGRES_HOST=postgres

# Cadena de conexión para la aplicación web (dentro de la red Docker usa el servicio 'postgres')
DATABASE_URL=postgresql://ecommerce_user:ecommerce_password@postgres:5432/ecommerce_db

# ------------------------------------------------------------------------------
# MINIO / S3 STORAGE (Almacenamiento de Imágenes, Recursos y Modelos 3D)
# ------------------------------------------------------------------------------
# Puertos externos del host (para acceso administrativo o consola MinIO)
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003

# Credenciales de acceso para MinIO / S3 Client
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=ecommerce-assets

# Endpoint interno para que el contenedor web se comunique con MinIO en la red Docker:
S3_ENDPOINT=http://minio:9000

# URL pública de los recursos multimedia:
# IMPORTANTE: En el servidor de deploy usa '/ecommerce-assets'.
# De esta manera, el servicio web actúa como reverse proxy transparente, sirviendo todas las fotos
# y modelos 3D bajo el mismo dominio (ej. https://blessed-sandals.mixgyt.com/ecommerce-assets/...)
# sin requerir abrir el puerto 9002 en el firewall del servidor ni causar errores de HTTPS mixto.
# Si usas un CDN externo o subdominio con certificado propio, puedes poner: https://cdn.tudominio.com
S3_PUBLIC_URL=/ecommerce-assets
S3_CONSOLE_URL=http://localhost:9003
S3_REGION=us-east-1
S3_USE_SSL=false
